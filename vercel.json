

{
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.5.15"
    }
  },
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/site-settings", "destination": "/api/site-settings/index" },
    { "source": "/api/impact-stats", "destination": "/api/impact-stats/index" },
    { "source": "/api/impact-stats/(.*)", "destination": "/api/impact-stats/index" },
    { "source": "/api/testimonials", "destination": "/api/testimonials/index" },
    { "source": "/api/testimonials/(.*)", "destination": "/api/testimonials/index" },
    { "source": "/api/contacts", "destination": "/api/contacts/index" },
    { "source": "/api/donations", "destination": "/api/donations/index" },
    { "source": "/api/events", "destination": "/api/events/index" },
    { "source": "/api/news", "destination": "/api/news/index" },
    { "source": "/api/gallery", "destination": "/api/gallery/index" },
    { "source": "/api/projects", "destination": "/api/projects/index" },
    { "source": "/api/admin/personnel", "destination": "/api/admin/personnel" },
    { "source": "/api/admin/personnel/(.*)", "destination": "/api/admin/personnel/$1" },
    { "source": "/api/admin(.*)", "destination": "/api/misc/admin$1" },
    { "source": "/api/profile(.*)", "destination": "/api/misc/profile$1" },
    { "source": "/api/memberships(.*)", "destination": "/api/misc/memberships$1" },
    { "source": "/api/event-registrations(.*)", "destination": "/api/misc/event-registrations$1" },
    { "source": "/api/members(.*)", "destination": "/api/misc/members$1" },
    { "source": "/api/zones(.*)", "destination": "/api/misc/zones$1" },
    { "source": "/api/tiers(.*)", "destination": "/api/misc/tiers$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}